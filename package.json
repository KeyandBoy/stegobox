{
  "name": "stegobox",
  "version": "1.0.0",
  "description": "StegoBox — robust image / file / text steganography derived from RAC-Hide. Hide secrets in DCT coefficients; survives JPEG re-compression and proportional rescaling. Runs entirely in the browser.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core.js",
    "./browser": "./src/browser.js"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "start": "python -m http.server 8000",
    "dev": "python -m http.server 8000"
  },
  "keywords": [
    "steganography",
    "watermarking",
    "dct",
    "jpeg",
    "reed-solomon",
    "information-hiding",
    "image-processing",
    "robust"
  ],
  "engines": {
    "node": ">=18"
  }
}
